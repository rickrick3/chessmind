#: analysis/views.py:35
#, python-format
msgid "You've used your %(n)s reviews this week. New ones open on Monday."
msgstr "Tu as utilisé tes %(n)s analyses de la semaine. Les nouvelles arrivent lundi."

#: games/views.py:23
msgid "Chess.com is not answering, showing the games already imported."
msgstr "Chess.com ne répond pas, voici les parties déjà importées."

#: players/views.py:30
msgid "Type your Chess.com username."
msgstr "Tape ton pseudo Chess.com."

#: players/views.py:35
msgid "Chess.com is not answering, try again in a minute."
msgstr "Chess.com ne répond pas, réessaie dans une minute."

#: players/views.py:38
#, python-format
msgid "No Chess.com player named “%(name)s”."
msgstr "Aucun joueur Chess.com ne s'appelle « %(name)s »."

#: templates/base.html:21
msgid "Sign out"
msgstr "Se déconnecter"

#: templates/base.html:30
msgid "Analysis by"
msgstr "Analyse par"

#: templates/base.html:30
msgid "source code"
msgstr "code source"

#: templates/game_list.html:3
msgid "Your recent games"
msgstr "Tes parties récentes"

#: templates/game_list.html:4
#, python-format
msgid "Free reviews left this week: %(left)s"
msgstr "Analyses gratuites restantes cette semaine : %(left)s"

#: templates/game_list.html:5
msgid "No standard games in the last two months."
msgstr "Aucune partie standard ces deux derniers mois."

#: templates/game_list.html:14
msgid "Review"
msgstr "Analyser"

#: templates/review.html:18
msgid "Back to games"
msgstr "Retour aux parties"

#: templates/review.html:23
msgid "Previous move"
msgstr "Coup précédent"

#: templates/review.html:24
msgid "Next move"
msgstr "Coup suivant"

