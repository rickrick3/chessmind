msgid "Analysing your game… this takes about a minute."
msgstr "Analyse de ta partie… environ une minute."

#: templates/review.html:37
msgid "The analysis failed. Go back and try again."
msgstr "L'analyse a échoué. Reviens en arrière et réessaie."

#: templates/review.html:38
msgid "Best move"
msgstr "Meilleur coup"

#: templates/review.html:38
msgid "Opponent can answer"
msgstr "L'adversaire peut répondre"

#: templates/review.html:39
msgid "best"
msgstr "meilleur"

#: templates/review.html:39
msgid "good"
msgstr "bon"

#: templates/review.html:39
msgid "inaccuracy"
msgstr "imprécision"

#: templates/review.html:40
msgid "mistake"
msgstr "erreur"

#: templates/review.html:40
msgid "blunder"
msgstr "gaffe"

#: templates/signin.html:4
msgid "Learn from your own games"
msgstr "Apprends de tes propres parties"

#: templates/signin.html:5
msgid ""
"Enter your Chess.com username. Every move of your recent games gets graded "
"and explained."
msgstr "Entre ton pseudo Chess.com. Chaque coup de tes parties récentes est noté et expliqué."

#: templates/signin.html:9
msgid "Chess.com username"
msgstr "Pseudo Chess.com"

#: templates/signin.html:10
